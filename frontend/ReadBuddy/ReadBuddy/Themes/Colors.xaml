<!--  ReadBuddy\Themes\Colors.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Brand Colors -->
    <Color x:Key="PrimaryColor">#FFa663cc</Color>
    <Color x:Key="SecondaryColor">#FF6f2dbd</Color>
    <Color x:Key="ThirdColor">#ffac7fe1</Color>
    <Color x:Key="AccentColor">#FFE0D7F1</Color>
    <Color x:Key="BackgroundColor">#FFd9c4ff</Color>
    <Color x:Key="BackgroundColor2">#FFe9deff</Color>
    <Color x:Key="ExtraLightColor">#FFfff2eb</Color>

    <!-- Custom Colors -->
    <Color x:Key="TransparentYellowColor">#78FFFF00</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="ThirdBrush" Color="{StaticResource ThirdColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="BackgroundBrush2" Color="{StaticResource BackgroundColor2}" />
    <SolidColorBrush x:Key="ExtraLightBrush" Color="{StaticResource ExtraLightColor}"/>
    <SolidColorBrush x:Key="TransparentYellowBrush" Color="{StaticResource TransparentYellowColor}" />

</ResourceDictionary>