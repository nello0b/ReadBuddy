<!-- ReadBuddy\Themes\CaptureOverlayStyles.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="CaptureOverlayBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="5" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="CaptureOverlayCaptureButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
        <Setter Property="Width" Value="200" />
        <Setter Property="Height" Value="50" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="CaptureOverlayCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource BackButtonStyle}">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="16" />
    </Style>

</ResourceDictionary>
