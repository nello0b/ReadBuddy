<!-- ReadBuddy\Views\Home\HomeView.xaml -->
<UserControl x:Class="ReadBuddy.Views.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ReadBuddy.Views.Controls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ReadBuddy;component/Resources/Converters.xaml" />
                <ResourceDictionary Source="/ReadBuddy;component/Themes/HomeViewStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- 🟪 Title -->
        <Viewbox Grid.Row="0" Grid.Column="0" Stretch="Uniform" MaxHeight="200">
            <TextBlock Text="Welcome to ReadBuddy"
                       FontSize="40"
                       FontWeight="Bold"
                       Foreground="{DynamicResource ExtraLightBrush}"
                       Margin="20,20,0,10"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Viewbox>

        <!-- 🟪 Capture Button -->
        <Button Grid.Row="0" Grid.Column="2"
                x:Name="CaptureButton"
                Style="{StaticResource PrimaryButtonStyle}"
                Width="200"
                Height="50"
                Margin="0,20,0,20"
                HorizontalAlignment="Center"
                Command="{Binding CaptureCommand}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <md:PackIcon Kind="AutoStories" Width="24" Height="24" Margin="0,0,8,0"/>
                <TextBlock Text="Study Mode"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="16"/>
            </StackPanel>
        </Button>

        <!-- 📥 Upload Control -->
        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
            <!-- Googly Eyes above the screenshot button -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <controls:GooglyEyeControl Margin="0,0,50,0" />
                <controls:GooglyEyeControl />
            </StackPanel>
            
            <Button Style="{StaticResource ButtonStyle}"
                    Width="150"
                    Command="{Binding TakeScreenshotCommand}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,0,8,0">
                    <TextBlock Text="Capture"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <md:PackIcon Kind="MonitorScreenshot" HorizontalAlignment="Center" VerticalAlignment="Center" Width="20" Height="20"/>
                </StackPanel>
            </Button>
            <controls:UploadControl
                                 x:Name="UploadPanel"
                                 FileUploadedCommand="{Binding UploadCommand}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
        </StackPanel>


        <!-- 📚 Sidebar -->
        <controls:OcrHistorySidebarControl Grid.Row="1" Grid.Column="2"
                                           x:Name="SidebarPanel"
                                           ItemsSource="{Binding CombinedItems}"/>

        <!-- 🔄 Loading Overlay -->
        <Grid x:Name="LoadingOverlay"
              Grid.Row="0" Grid.RowSpan="2"
              Grid.Column="0" Grid.ColumnSpan="3"
              Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Panel.ZIndex="99">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource LoadingProgressBarStyle}"/>
                <TextBlock Text="Processing..." Foreground="White"
                           Style="{StaticResource LoadingTextStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
