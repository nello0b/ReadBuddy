<!-- ReadBuddy\Views\History\HistoryListView.xaml -->
<UserControl x:Class="ReadBuddy.Views.HistoryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:ReadBuddy.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sorting controls section -->
        <DockPanel Margin="10,8,10,8" Grid.Row="0" LastChildFill="False">
            <!-- Category filter ComboBox -->
            <ComboBox Width="230" Margin="0,0,10,0"
                  Style="{StaticResource ComboBoxFlatStyle}"
                  ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  DockPanel.Dock="Left"/>
            <!-- Sort options dropdown -->
            <ComboBox Width="150"
                Margin="0,0,8,0"
                ItemsSource="{Binding SortFields}"
                SelectedItem="{Binding SelectedSortField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource ComboBoxFlatStyle}"
                DockPanel.Dock="Left"/>

            <!-- Toggle ascending/descending -->
            <Button Width="40"
                Height="40"
                Command="{Binding ToggleSortDirectionCommand}"
                ToolTip="Toggle ascending/descending"
                Style="{StaticResource ButtonStyle}"
                DockPanel.Dock="Left">
                <md:PackIcon Kind="{Binding SortDirectionIcon}" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>

            <ToggleButton Width="40" Height="40" Style="{StaticResource ToggleButtonStyle}" ToolTip="Hide running Tasks"
                          IsChecked="{Binding HideTasks, Mode=TwoWay}">
                <md:PackIcon Kind="ImageSync" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </ToggleButton>

            <!-- Googly Eyes between the toggle and reload buttons -->
            <StackPanel Orientation="Horizontal" Margin="10,0,10,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                <controls:GooglyEyeControl Margin="0,0,20,0" />
                <controls:GooglyEyeControl />
            </StackPanel>

            <!-- Reload button -->
            <Button
                Command="{Binding ReloadCommand}"
                Width="40" Height="40" Margin="0,0,8,0"
                Style="{StaticResource ButtonStyle}"
                DockPanel.Dock="Right" ToolTip="Reset">
                <md:PackIcon Kind="Reload" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
        </DockPanel>

        <!-- List of summaries section -->
        <controls:OcrHistorySidebarControl Grid.Row="1" Margin="10,0,0,0"
                                DataContext="{Binding}" ShowDeleteButton="True"
                                ItemsSource="{Binding DisplayItems}" />

    </Grid>
</UserControl>
