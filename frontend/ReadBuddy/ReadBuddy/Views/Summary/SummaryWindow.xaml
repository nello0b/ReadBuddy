<!-- ReadBuddy\Views\Summary\SummaryWindow.xaml -->
<Window x:Class="ReadBuddy.Views.Summary.SummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReadBuddy.Views.Summary"
        xmlns:controls="clr-namespace:ReadBuddy.Views.Controls"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SummaryWindow"
        Height="450" Width="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ReadBuddy;component/Themes/SummaryWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>


    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      CaptionHeight="0"
                      CornerRadius="20"
                      UseAeroCaptionButtons="False"
                      ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title bar -->
            <RowDefinition Height="Auto"/>
            <!-- Utility bar -->
            <RowDefinition Height="*"/>
            <!-- Summary content -->
        </Grid.RowDefinitions>

        <!-- 🔷 Title Bar -->
        <controls:TitleBar Grid.Row="0" />

        <!-- 🛠️ Utility Bar -->
        <DockPanel Grid.Row="1"
                   Margin="10"
                   LastChildFill="False"
                   VerticalAlignment="Center">

            <Button
                    Command="{Binding CopyCommand}"
                    Style="{StaticResource ButtonStyle}"
                    ToolTip="Copy summary to clipboard"
                    DockPanel.Dock="Right" Height="50">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <md:PackIcon Kind="ContentCopy" Width="22" Height="22" Margin="0,0,0,0"/>
                    <TextBlock Text="Copy All" VerticalAlignment="Center" FontWeight="Bold" FontSize="17"/>
                </StackPanel>
            </Button>

            <controls:PlayStopControl
                PlayCommand="{Binding PlayCommand}"
                StopCommand="{Binding StopCommand}"
                PlayIcon="{Binding PlayIcon}"
                StopIcon="Stop"
                DockPanel.Dock="Left" />

            <!-- Googly Eyes watching the summary -->
            <StackPanel Orientation="Horizontal" 
                        Margin="20,0,20,0" 
                        VerticalAlignment="Center" 
                        DockPanel.Dock="Left">
                <controls:GooglyEyeControl Margin="0,0,50,0" />
                <controls:GooglyEyeControl />
            </StackPanel>
        </DockPanel>

        <!-- 📜 Scrollable Summary Content -->
        <RichTextBox x:Name="SummaryRichTextBox"
            Grid.Row="2"
            Margin="10,0,10,10"
            FontSize="16"
            Style="{StaticResource SummaryTextStyle}"
            IsReadOnly="True"
            VerticalScrollBarVisibility="Auto" />
    </Grid>
</Window>
