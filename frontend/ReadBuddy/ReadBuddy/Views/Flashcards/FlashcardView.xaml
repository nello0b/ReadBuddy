<!-- ReadBuddy\Views\Flashcards\FlashcardView.xaml -->
<UserControl x:Class="ReadBuddy.Views.Flashcards.FlashcardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:ReadBuddy.Views.Controls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <!-- Back button -->
        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <controls:GooglyEyeControl Margin="0,0,50,0" />
            <controls:GooglyEyeControl />
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,20,5">
            <Button Style="{StaticResource BackButtonStyle}"
                    Command="{Binding BackCommand}"
                    ToolTip="Back">
                <md:PackIcon Kind="ArrowRight" Width="24" Height="24"/>
            </Button>
        </StackPanel>

        <!-- Main card area -->
        <Grid Grid.Column="0" Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center" 
                        Margin="0,0,0,10">
                <TextBlock Text="{Binding ProgressText}" 
                           FontSize="20" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0"/>
            </StackPanel>
            <Border x:Name="CardBorder" Grid.Row="1" Style="{StaticResource FlashcardBorderStyle}">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CardScaleTransform" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <!-- Scrollable text content area -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="10">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                    </ScrollViewer.Resources>
                    <!-- Main text that flips between term and definition -->
                    <TextBlock Text="{Binding DisplayedText}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               TextWrapping="Wrap" 
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" 
                               TextAlignment="Center"
                               Margin="20" />
                </ScrollViewer>
            </Border>

            <!-- Flip Button (outside the border) -->
            <Button Grid.Row="2" 
                    Style="{StaticResource ButtonStyle}" 
                    Command="{Binding FlipCardCommand}"
                    Content="{Binding FlipButtonText}"
                    Margin="0,20,0,10"
                    HorizontalAlignment="Center"
                    MinWidth="100"
                    x:Name="FlipButton">
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.Click">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardScaleTransform"
                                               Storyboard.TargetProperty="ScaleX"
                                               From="1" To="0" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardScaleTransform"
                                               Storyboard.TargetProperty="ScaleX"
                                               From="0" To="1" Duration="0:0:0.15" 
                                               BeginTime="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Style="{StaticResource ButtonStyle}" Command="{Binding PrevCardCommand}">
                    <md:PackIcon Kind="ChevronLeft" Width="40" Height="40"/>
                </Button>
                <Button Style="{StaticResource ButtonStyle}" Command="{Binding NextCardCommand}">
                    <md:PackIcon Kind="ChevronRight" Width="40" Height="40"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Sidebar to jump between cards -->
        <controls:QuizJumpSidebarControl Grid.Column="1" Grid.Row="1" 
                                         HeaderText="Jump To Card"
                                         DataContext="{Binding}" />
    </Grid>
</UserControl>
