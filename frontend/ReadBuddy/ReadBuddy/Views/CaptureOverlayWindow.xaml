<!-- ReadBuddy\Views\CaptureOverlayWindow.xaml-->
<Window x:Class="ReadBuddy.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ReadBuddy.Views.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="300" Height="200"
        Topmost="True"
        ShowInTaskbar="False"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ReadBuddy;component/Themes/CaptureOverlayStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainBorder" Style="{StaticResource CaptureOverlayBorderStyle}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <Button Style="{StaticResource CaptureOverlayCaptureButtonStyle}"
                        Click="CaptureSnip_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Capture"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <md:PackIcon Kind="MonitorScreenshot" HorizontalAlignment="Center" VerticalAlignment="Center" Width="25" Height="25"/>
                    </StackPanel>
                </Button>

                <Button Content="Close"
                        Style="{StaticResource CaptureOverlayCloseButtonStyle}"
                        Click="Close_Click"/>
            </StackPanel>
        </Border>
        <controls:GooglyEyeControl x:Name="LeftEye"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Margin="10"
                                   EdgePadding="5" />
        <controls:GooglyEyeControl x:Name="RightEye"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Margin="10"
                                   EdgePadding="5" />
        <Button x:Name="DockLeftButton" Style="{StaticResource CaptureOverlayCaptureButtonStyle}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="10" Height="60" Width="60" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Bottom"  Margin="5" Click="DockLeftButton_Click">
            <Canvas Width="20" Height="20">
                <Path x:Name="DockLeftIcon" Stroke="Black" StrokeThickness="4" Data="M0,0 L0,20 L20,20"/>
            </Canvas>
        </Button>
        <Button x:Name="DockRightButton" Style="{StaticResource CaptureOverlayCaptureButtonStyle}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="10" Height="60" Padding="0" Width="60" HorizontalAlignment="Right" VerticalAlignment="Bottom"  Margin="5" Click="DockRightButton_Click">
            <Path x:Name="DockRightIcon" Stroke="Black" StrokeThickness="4" Data="M20,0 L20,20 L0,20"/>
        </Button>
    </Grid>
</Window>
