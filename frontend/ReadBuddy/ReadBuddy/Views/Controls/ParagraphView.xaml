<!-- ReadBuddy\Views\Controls\ParagraphView.xaml -->
<UserControl x:Class="ReadBuddy.Views.Controls.ParagraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="RootControl"
             Height="Auto" Width="Auto">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ReadBuddy;component/Themes/ParagraphViewStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource ParagraphRowStyle}"
          
                     MouseEnter="OnMouseEnterHandler"
                     MouseLeave="OnMouseLeaveHandler">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Paragraph text -->
        <RichTextBox x:Name="ItemRtb"
                     Style="{StaticResource ParagraphRichTextStyle}"
                     Grid.Column="0">
            <FlowDocument>
                <Paragraph>
                    <Run Text="{Binding Content}" />
                </Paragraph>
            </FlowDocument>
        </RichTextBox>

        <!-- Buttons -->
        <Grid Grid.Column="1" VerticalAlignment="Stretch" >
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Style="{StaticResource ParagraphIconButtonStyle}"
                    ToolTip="Copy"
                    Command="{Binding CopyCommand, ElementName=RootControl}"
                    CommandParameter="{Binding Content}">
                <md:PackIcon Kind="ContentCopy"
                             Width="25" Height="25" />
            </Button>

            <Button Grid.Row="1"
                    Style="{StaticResource ParagraphIconButtonStyle}"
                    Margin="5,0,0,0"
                    ToolTip="Play"
                    Command="{Binding PlayCommand, ElementName=RootControl}"
                    CommandParameter="{Binding}">
                <md:PackIcon Kind="Play"
                             Width="25" Height="25" />
            </Button>
        </Grid>
    </Grid>

</UserControl>
