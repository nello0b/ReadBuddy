<!-- ReadBuddy\Views\Controls\PlayStopControl.xaml -->
<UserControl x:Class="ReadBuddy.Views.Controls.PlayStopControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:ReadBuddy.Views.Controls"
             Height="50" Width="120">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ReadBuddy;component/Themes/PlayStopControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource PlayStopControlContainerStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Play Button (left) -->
            <Button Grid.Column="0"
            Style="{StaticResource PlayButtonStyle}"
            Command="{Binding PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <md:PackIcon Kind="{Binding PlayIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Width="24" Height="24" />
            </Button>

            <!-- Stop Button (right) -->
            <Button Grid.Column="1"
            Style="{StaticResource StopButtonStyle}"
            Command="{Binding StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <md:PackIcon Kind="{Binding StopIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Width="24" Height="24" />
            </Button>

            <!-- Divider -->
            <Rectangle Grid.Column="1"
               Style="{StaticResource DividerLineStyle}" />
        </Grid>
    </Border>
</UserControl>
