<!-- ReadBuddy\Views\Controls\UploadControl.xaml -->
<UserControl x:Class="ReadBuddy.Views.Controls.UploadControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReadBuddy.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="Root"
             AllowDrop="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ReadBuddy;component/Themes/UploadControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Viewbox Stretch="Uniform" Margin="40"
                 MaxHeight="500" MaxWidth="600" MinHeight="200" MinWidth="300">

            <Border x:Name="DropBorder"
        Style="{StaticResource DropZoneBorderStyle}">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom"
                TextBlock.FontSize="14"
                TextBlock.Foreground="Gray"
                TextBlock.TextAlignment="Center" Margin="0,0,0,34">

                    <TextBlock Text="Drag and drop an image file here" />
                    <TextBlock Text="or" Margin="5"/>
                    <Button x:Name="BrowseButton" Height="40" Width="100"
                Content="Browse…"
                Style="{StaticResource UploadBrowseButtonStyle}" />
                </StackPanel>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
