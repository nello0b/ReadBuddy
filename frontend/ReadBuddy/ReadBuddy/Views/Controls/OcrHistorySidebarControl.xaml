<!-- ReadBuddy\Views\Controls\OcrHistorySidebarControl.xaml -->
<UserControl x:Class="ReadBuddy.Views.Controls.OcrHistorySidebarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ReadBuddy.Views.Controls"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:services="clr-namespace:ReadBuddy.Services"
    xmlns:models="clr-namespace:ReadBuddy.Models.Extraction"
    xmlns:taskmodels="clr-namespace:ReadBuddy.Models.Tasks"
    mc:Ignorable="d"
    d:DesignHeight="400" d:DesignWidth="250">

    <!-- Resource Dictionaries -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ReadBuddy;component/Themes/SidebarStyles.xaml" />
                <ResourceDictionary Source="/ReadBuddy;component/Resources/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Template for TaskTracker -->
            <DataTemplate DataType="{x:Type taskmodels:TaskTracker}">
                <Border Margin="10,0,10,10" Style="{StaticResource TaskCardBorderStyle}">
                    <StackPanel Margin="10">
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,5"/>
                        <ProgressBar Style="{DynamicResource TaskProgressBarStyle}"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="10"
                                     Value="{Binding Progress}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Template for ExtractionResultSummary -->
            <DataTemplate DataType="{x:Type models:ExtractionResultSummary}">
                <Grid Margin="10,0,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:NewTag Grid.ColumnSpan="2"
                                  HorizontalAlignment="Left"
                                  Visibility="{Binding CreatedAt, Converter={StaticResource IsNewToVisibilityConverter}}"/>

                    <Button Grid.Column="0"
                            Style="{StaticResource HistoryCardButtonStyle}"
                            Command="{Binding DataContext.SummarySelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            HorizontalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding Category}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           DockPanel.Dock="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ShowDeleteButton, Converter={StaticResource BoolToVisibilityConverter}}">

                        <Button 
                            Style="{StaticResource ButtonStyle}"
                            Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="Edit Category"
                            Padding="0"
                            Margin="10,0,0,0"
                            Width="60"
                            >
                            <md:PackIcon Kind="TagEdit" Width="20" Height="20"/>
                        </Button>

                        <Button 
                            Style="{StaticResource ButtonStyle}"
                            Command="{Binding DataContext.DeleteExtractionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="Delete"
                            Padding="0"
                            Margin="10,0,0,0"
                            Width="60"
                            >
                            <md:PackIcon Kind="Delete" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Main Border -->
    <Border Margin="0"
            BorderBrush="{DynamicResource PrimaryBrush}"
            BorderThickness="2,2,0,0"
            CornerRadius="20,0,0,0"
            Background="{DynamicResource AccentBrush}">
        <DockPanel Margin="0,0,5,0" LastChildFill="True">
            <TextBlock Text="OCR Results"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryBrush}"
                       Margin="10"
                       DockPanel.Dock="Top"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                </ScrollViewer.Resources>

                <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <!-- No need for ItemTemplate — WPF picks the DataTemplate by type -->
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
