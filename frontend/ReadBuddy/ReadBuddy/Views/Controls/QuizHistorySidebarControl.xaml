<!-- ReadBuddy\Views\Controls\QuizHistorySidebarControl.xaml -->
<UserControl x:Class="ReadBuddy.Views.Controls.QuizHistorySidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
            xmlns:quiz="clr-namespace:ReadBuddy.Models.Quiz"
            xmlns:taskmodels="clr-namespace:ReadBuddy.Models.Tasks"
            xmlns:local="clr-namespace:ReadBuddy.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="250">

    <!-- Resources -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ReadBuddy;component/Themes/SidebarStyles.xaml" />
                <ResourceDictionary Source="/ReadBuddy;component/Resources/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Template for TaskTracker -->
            <DataTemplate DataType="{x:Type taskmodels:TaskTracker}">
                <Border Margin="10,0,10,10" Style="{StaticResource TaskCardBorderStyle}">
                    <StackPanel Margin="10">
                        <TextBlock Text="{Binding Message}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="Black"
                                   Margin="0,0,0,5"/>
                        <ProgressBar Style="{DynamicResource TaskProgressBarStyle}"
                                     Minimum="0" Maximum="100" Height="10"
                                     Value="{Binding Progress}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Template for QuizSummary -->
            <DataTemplate DataType="{x:Type quiz:QuizSummary}">
                <Grid Margin="6,6,3,6">
                    <local:NewTag HorizontalAlignment="Left"
                                  Visibility="{Binding CreatedAt, Converter={StaticResource IsNewToVisibilityConverter}}"/>
                    <DockPanel>
                        <Button Style="{StaticResource HistoryCardButtonStyle}" Width="160"
                                Command="{Binding DataContext.QuizSummaryClickedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Category}" FontStyle="Italic"/>
                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           FontSize="11"/>
                                <TextBlock>
                                    <Run Text="Questions Count: "/>
                                    <Run Text="{Binding QuestionIds.Count, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ButtonStyle}"
                                Command="{Binding DataContext.DeleteQuizCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="Delete this quiz" Padding="0" Margin="5,5,10,5"
                                Visibility="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ShowDeleteButton, Converter={StaticResource BoolToVisibilityConverter}}">
                            <md:PackIcon Kind="Delete" Width="20" Height="20"/>
                        </Button>
                    </DockPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Main Border Container -->
    <Border Margin="0"
            BorderBrush="{DynamicResource PrimaryBrush}"
            BorderThickness="2,2,0,0"
            CornerRadius="20,0,0,0"
            Background="{DynamicResource AccentBrush}">
        <DockPanel Margin="0,0,5,0" LastChildFill="True">
            <TextBlock Text="Quiz History"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryBrush}"
                       Margin="10" DockPanel.Dock="Top"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                </ScrollViewer.Resources>
                <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
