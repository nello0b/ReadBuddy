<!-- ReadBuddy\Views\Controls\OcrImageControl.xaml -->
<UserControl x:Class="ReadBuddy.Views.Controls.OcrImageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ReadBuddy.Views.Controls"
             xmlns:shared="clr-namespace:ReadBuddy.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="OcrControl">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Include styles and resources specific to this control -->
                <ResourceDictionary Source="/ReadBuddy;component/Themes/OcrImageControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Main layout grid with two columns: left for image/controls, right for sidebar -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Left column: contains TTS buttons and image viewer -->
        <DockPanel Grid.Column="0">

            <!-- TTS Button Row: Play, Pause, Stop -->
            <Grid DockPanel.Dock="Top"
                  HorizontalAlignment="Stretch"
                  Margin="10,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <shared:PlayStopControl Grid.Column="0"
                                        PlayCommand="{Binding PlayPauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        StopCommand="{Binding StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        PlayIcon="{Binding PlayIcon}"
                                        StopIcon="Stop"
                                        HorizontalAlignment="Left" />
            </Grid>
            <Grid>
                <!-- Image viewer with zoom and overlay support -->
                <ScrollViewer x:Name="ZoomScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ZoomScrollViewer_MouseWheel"
                          PreviewMouseRightButtonDown="ZoomScrollViewer_PreviewMouseRightButtonDown"
                          PreviewMouseRightButtonUp="ZoomScrollViewer_PreviewMouseRightButtonUp"
                          PreviewMouseMove="ZoomScrollViewer_PreviewMouseMove"
                          Style="{StaticResource ModernScrollViewer}">


                    <Grid>
                        <!-- Zoom transform for scaling the image and overlay -->
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ZoomTransform" ScaleX="1.0" ScaleY="1.0"/>
                        </Grid.LayoutTransform>

                        <!-- OCR image display -->
                        <Image x:Name="OcrImage"
                           Stretch="None"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top" />
                        <!-- Overlay canvas for drawing highlights or selections -->
                        <Canvas x:Name="OverlayCanvas"
                            IsHitTestVisible="True"
                            Background="Transparent"/>
                    </Grid>
                </ScrollViewer>
                <Button x:Name="ResetZoomButton"
                    Style="{StaticResource ResetZoomButtonStyle}"
                    Command="{Binding ResetZoomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>
        </DockPanel>

        <!-- Right column: sidebar with recognized paragraphs and copy controls -->
        <Border Grid.Column="1" Padding="5"
                 Style="{StaticResource ParagraphSidebar}">
            <DockPanel>
                <!-- Copy All button for copying all recognized text -->
                <Button Style="{StaticResource CopyAllButtonStyle}" DockPanel.Dock="Top" HorizontalAlignment="Center"
        Command="{Binding CopyAllCommand}"/>



                <!-- Scrollable list of recognized paragraphs -->
                <ScrollViewer x:Name="ParagraphScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                    </ScrollViewer.Resources>
                    <ItemsControl x:Name="ParagraphItemsControl"
              ItemsSource="{Binding OcrResult.Paragraphs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Each paragraph row: RichTextBox for text, button to copy -->
                                <shared:ParagraphView
    DataContext="{Binding}"                      
    CopyCommand="{Binding DataContext.CopyParagraphCommand, ElementName=OcrControl}"
    PlayCommand="{Binding PlayParagraphCommand,   ElementName=OcrControl}"
    MouseEnterCommand="{Binding ParagraphMouseEnterCommand, ElementName=OcrControl}"
    MouseLeaveCommand="{Binding ParagraphMouseLeaveCommand, ElementName=OcrControl}" />



                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
